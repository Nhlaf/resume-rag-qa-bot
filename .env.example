# Chat model provider: groq, openai, anthropic, or testleaf
MODEL_PROVIDER=groq
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=your-groq-model-name
TEMPERATURE=0.1

# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/
MONGODB_DB_NAME=db_resumes
MONGODB_COLLECTION=resumes
MONGODB_VECTOR_INDEX=resume_vector_index

# Embeddings (mistral or openai)
EMBEDDING_PROVIDER=mistral
MISTRAL_API_KEY=replace-with-your-mistral-api-key
EMBEDDING_MODEL=mistral-embed
EMBEDDING_DIMENSION=1024

# Local documents and HTTP server
DOCUMENTS_FOLDER=./documents
PORT=8787

# Optional tuning
# MAX_TOKENS=4096
# INGESTION_BATCH_SIZE=10
# HYBRID_VECTOR_WEIGHT=0.7
# HYBRID_KEYWORD_WEIGHT=0.3
# LLM_RERANKING_ENABLED=true
# LLM_RETRIEVAL_TOP_K=10
